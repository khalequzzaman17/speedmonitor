#include <windows.h>

// Application Icon (Lowest ID becomes the default application icon in Windows Explorer)
101 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Khalequzzaman"
            VALUE "FileDescription", "SpeedMonitor - Real-time Network Speed Monitor for Windows 10/11"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SpeedMonitor"
            VALUE "LegalCopyright", "Copyright (c) 2026 Khalequzzaman. All rights reserved."
            VALUE "OriginalFilename", "SpeedMonitor.exe"
            VALUE "ProductName", "SpeedMonitor"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "Author", "Khalequzzaman"
            VALUE "Comments", "https://github.com/khalequzzaman17/speedmonitor"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
